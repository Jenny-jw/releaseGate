# Release Gate 設定範本。複製成 .env 再修改；.env 不會進版本控制。
# 每一項都可以留空，留空時使用預設值。

# OpenAI 相容 API 金鑰。留空就是無金鑰模式：閘道、檢索、工單照常運作，助理不產生結論。
OPENAI_API_KEY=

# API 位址。換成其他 OpenAI 相容服務時修改。
OPENAI_BASE_URL=https://api.openai.com/v1

# 回答與程式審查用的模型（預設值待定）。
LLM_MODEL=

# 有金鑰時的 embeddings 模型（預設值待定）。
EMBEDDING_MODEL=

# 沒有金鑰時的 embeddings：chroma（本機模型，第一次執行需下載）或 hash（不需下載，斷網可用）。
LOCAL_EMBEDDINGS=chroma

# 法務工單 webhook。
LEGAL_WEBHOOK_URL=http://localhost:8000/webhooks/legal-ticket

# webhook HMAC 簽章金鑰。留空使用演示用預設值，正式環境必須設定。
WEBHOOK_SECRET=
